# Per-install encrypted user data — never shared, never committed.
backend/data/*
!backend/data/.gitkeep

# Rotating runtime log (app/diagnostics/logging_setup.py). In a dev checkout
# USER_DATA_DIR is backend/ itself, so this lands in the tree.
backend/logs/

# Downloaded model weights — see scripts/setup.py.
backend/models/**/*.gguf
backend/models/**/*.onnx
backend/models/**/*.bin

# Exported hearth_ai ONNX (regenerate via hearth_ai/examples/export_onnx.py)
models/nlp/**/*.onnx
models/nlp/**/*.json

# Optional voice-input models (fetch via scripts/fetch_voice_models.py).
# ~29 MB of third-party weights, digest-pinned in that script rather than
# vendored — see docs/attributions.md for their licences.
models/voice/*.onnx

# PyInstaller build workdir — scripts/build_backend.sh/.ps1's --workpath.
/.pyinstaller-build

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local dev env overrides — see backend/.env.example for what's available.
backend/.env

# Stamped at freeze / release-build time from the v* git tag (see
# scripts/build_backend.sh and app/version.py). Not a source of truth.
backend/app/VERSION

# Node (frontend/, desktop/, website/ each have their own too, this covers the rest)
node_modules/

# Astro product site build output + synced brand copies
website/dist/
website/public/brand/

# local files. project-plan.md used to live here — it is now tracked at
# docs/project-plan.md, since the code cites it normatively (grep for it)
# and a contributor who can't read it can't answer "why is it built this
# way". project-phases.md is still local and still cited; publish or
# de-cite it the same way if that becomes a problem.
project-phases.md
.claude/
The Book/
# derived from The Book/, so it stays local for the same reason the Book does
THF_implementation_plan.md
.cursor/
.codex/
.vscode/
.env

# hearth_ai is a submodule (see .gitmodules). Ignore rules for its prepared
# HF JSONL and training checkpoints live in hearth_ai/.gitignore instead —
# a superproject's rules do not apply inside a submodule's working tree.