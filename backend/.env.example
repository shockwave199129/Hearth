# Copy this file to backend/.env and fill in what you need — see
# app/config.py's load_dotenv() call. Only used for local dev; the packaged
# desktop app sets these itself (see scripts/build_backend.sh/.ps1) and
# ignores this file entirely.

# Path to the llama.cpp llama-server binary. Defaults to plain
# "llama-server" (expects it on PATH) if unset. Build/download one
# yourself (https://github.com/ggerganov/llama.cpp) or run
# `python scripts/fetch_llama_cpp.py` from the repo root, which places a
# prebuilt binary at desktop/src-tauri/resources/llama-cpp/llama-server(.exe).
# LLAMA_SERVER_BIN=/path/to/llama-server

# Bind address / port (Docker sets APP_HOST=0.0.0.0). Desktop/local venv
# leave these unset so the backend stays loopback-only.
# APP_HOST=127.0.0.1
# APP_PORT=48173

# Shared secret every /api request and the /ws handshake must present
# (`X-Hearth-Token` header, or `?token=` on the websocket). The packaged app
# generates one per launch in the Tauri shell and passes it to both the
# backend and the webview — loopback keeps the network out, this keeps other
# local processes out. Leave unset for dev, --cli, and Docker: unset means
# no check, which is what a manually started backend and a plain browser
# frontend both expect.
# HEARTH_API_TOKEN=

# Where opt-in crash reports are PUT after the user confirms the prompt.
# Defaults to the public hearth-sub prefix. Must be HTTPS. The bucket needs
# a policy that allows PutObject on this prefix (the app ships no AWS keys).
# CRASH_LOGS_BUCKET_URL=https://hearth-sub.s3.ap-south-1.amazonaws.com/hearth_ai/crash-logs
# HEARTH_APP_VERSION=0.3.1
