{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hearth_ai/annotation/strategy",
  "title": "Hearth Strategy annotation",
  "description": "Suggested response strategy for StrategyHead. Scheduler owns final strategy; this is a hint only.",
  "type": "object",
  "required": ["text", "strategy"],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "enum": [
        "listen",
        "validate",
        "reflect",
        "comfort",
        "encourage",
        "celebrate",
        "advise",
        "ask_question",
        "plan",
        "ground",
        "boundary",
        "defer_safety"
      ]
    },
    "intent_hint": {
      "type": "string",
      "description": "Optional companion intent that motivated this strategy."
    },
    "annotator": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
