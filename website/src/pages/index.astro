---
import Base from "../layouts/Base.astro";
import { asset, home } from "../lib/paths";

const repo = "https://github.com/shockwave199129/Hearth";
const releases = `${repo}/releases`;
const docs = `${repo}/tree/main/docs`;

const stack = [
  "LFM2.5-1.2B",
  "Moonshine STT",
  "Parler-TTS",
  "Kokoro",
  "EmbeddingGemma",
  "Chroma",
  "LangChain",
  "FastAPI",
  "React",
  "Tauri",
];
---

<Base>
  <a class="skip" href="#features">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={home} aria-label="Hearth home">
        <img src={asset("brand/logo.png")} alt="" width="182" height="183" />
        <span>Hearth</span>
      </a>

      <nav class="nav" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href="#memory">Memory</a>
        <a href="#stack">Stack</a>
        <a href={docs}>Docs</a>
      </nav>

      <div class="header-actions">
        <a class="btn btn-secondary btn-sm" href={repo}>GitHub</a>
        <a class="btn btn-primary btn-sm" href={releases}>Download</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>

      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="badge">
            <span class="dot" aria-hidden="true"></span>
            100% local · No account · No telemetry
          </p>

          <h1 id="hero-title">
            Your AI companion.<br />
            <span class="gradient-text">Private. Local. Always yours.</span>
          </h1>

          <p class="lead hero-lead">
            Hearth remembers what matters to you — your goals, the people in
            your life, what you have been carrying — and keeps every word of it
            on your own disk, encrypted and yours to read, correct, or delete.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href={releases}>Download for desktop</a>
            <a class="btn btn-secondary" href={repo}>View source</a>
          </div>

          <ul class="hero-meta">
            <li>Windows · macOS · Linux</li>
            <li>Works offline</li>
            <li>Apache-2.0</li>
          </ul>
        </div>

        <figure class="hero-art">
          <img
            src={asset("brand/app-preview.png")}
            alt="The Hearth desktop app, showing chat, memory, knowledge and settings alongside a local voice input and a badge confirming all data stays on your device"
            width="670"
            height="497"
            fetchpriority="high"
          />
        </figure>
      </div>

      <a class="scroll-cue" href="#features">
        <span>Explore</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </section>

    <section id="features" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Why Hearth</p>
          <h2>Built on architecture, not promises</h2>
          <p class="lead">
            Most companions either forget you between sessions or remember you
            on someone else's servers. Hearth does neither.
          </p>
        </div>

        <ul class="cards">
          <li class="card reveal">
            <span class="card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M12 3l7 3v5.5c0 4.2-2.9 7.9-7 9-4.1-1.1-7-4.8-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <h3>Private by design</h3>
            <p>
              Speech, memory, and conversation stay on hardware you own. No
              cloud round-trip, no tracking, no analytics build.
            </p>
          </li>

          <li class="card reveal">
            <span class="card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M12 5.5a3 3 0 00-6 0 3 3 0 00-1.5 5.6A3 3 0 006 16.5a3 3 0 006 1.5m0-12.5a3 3 0 016 0 3 3 0 011.5 5.6A3 3 0 0118 16.5a3 3 0 01-6 1.5m0-12.5v12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <h3>Memory that persists</h3>
            <p>
              Context accumulates over months, not minutes — and every entry is
              inspectable, editable, and deletable by you.
            </p>
          </li>

          <li class="card reveal">
            <span class="card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"></rect>
                <path d="M5 11a7 7 0 0014 0M12 18v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
              </svg>
            </span>
            <h3>Talk or type</h3>
            <p>
              Local speech-to-text and text-to-speech when you want to speak, a
              keyboard when you don't. Same companion either way.
            </p>
          </li>

          <li class="card reveal">
            <span class="card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                <path d="M12 12l8-4.5M12 12v9m0-9L4 7.5" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
              </svg>
            </span>
            <h3>Open and yours</h3>
            <p>
              Apache-2.0 and self-hosted, built on open models and tooling you
              can audit, swap, or fork.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section id="privacy" class="section split">
      <div class="container split-grid">
        <figure class="art-card wide reveal">
          <img
            src={asset("brand/privacy-art.png")}
            alt="A laptop showing a shield and padlock, labelled encrypted storage and offline first"
            width="314"
            height="210"
          />
        </figure>

        <div class="reveal">
          <p class="eyebrow">Private by architecture</p>
          <h2>Nothing leaves your device</h2>
          <p class="lead">
            Not a policy promise you have to trust — a design a cloud companion
            cannot match without rebuilding. The single exception is a narrow,
            explicitly consented crisis path, documented in the open rather
            than buried in a privacy policy.
          </p>
          <p class="split-link">
            <a class="text-link" href={`${repo}/blob/main/docs/privacy.md`}>
              Read the privacy model
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <section id="memory" class="section">
      <div class="container split-grid reverse">
        <div class="reveal">
          <p class="eyebrow">Long-term memory</p>
          <h2>Remembers what matters</h2>
          <p class="lead">
            Hearth builds a long-term picture of your life and keeps it on your
            disk — no engagement optimisation, no guilt on exit, no dependency
            loops. Continuity without an account.
          </p>
          <p class="split-link">
            <a class="text-link" href={`${repo}/blob/main/docs/architecture.md`}>
              How memory works
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </p>
        </div>

        <figure class="art-card wide reveal">
          <img
            src={asset("brand/memory-art.png")}
            alt="A neural-network illustration linking the things Hearth remembers: your preferences, past conversations, important moments, and personal goals"
            width="341"
            height="210"
          />
        </figure>
      </div>
    </section>

    <section id="stack" class="section stack">
      <div class="container stack-inner reveal">
        <p class="eyebrow">Open stack</p>
        <h2>Everything runs where you can see it</h2>
        <ul class="chips center">
          {stack.map((item) => <li class="chip">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section note-section">
      <div class="container">
        <div class="note reveal">
          <h2>What Hearth is not</h2>
          <p class="lead">
            Not a therapist, not a medical device, not a crisis service. It does
            not diagnose, treat, or prevent any condition, and it is not a
            substitute for professional care. Intended for adults 18+. When a
            conversation suggests someone is at risk, Hearth's job is to
            respond safely and point toward real human help.
          </p>
          <p class="split-link">
            <a class="text-link" href={`${repo}/blob/main/docs/positioning.md`}>
              How we position this
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="container">
        <div class="cta-panel reveal">
          <img
            class="cta-mark"
            src={asset("brand/logo.png")}
            alt=""
            width="182"
            height="183"
          />
          <h2>Run it on your own machine</h2>
          <p class="lead cta-lead">
            Open source, self-hosted, and yours to inspect or change. Unsigned
            builds today, signed store releases at 1.0.
          </p>
          <div class="hero-actions center">
            <a class="btn btn-primary" href={releases}>Download releases</a>
            <a class="btn btn-secondary" href={docs}>Browse the docs</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img
          class="footer-logo"
          src={asset("brand/full-logo.png")}
          alt="Hearth — Your AI Companion."
          width="321"
          height="180"
        />
        <p class="footer-note">Works offline. Works for you.</p>
      </div>

      <nav class="footer-links" aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/docs/privacy.md`}>Privacy</a>
        <a href={`${repo}/blob/main/docs/compliance.md`}>Safety</a>
        <a href={`${repo}/blob/main/LICENSE`}>Apache-2.0</a>
      </nav>
    </div>
  </footer>
</Base>

<script>
  const header = document.querySelector(".site-header");
  const setStuck = () =>
    header?.classList.toggle("is-stuck", window.scrollY > 8);

  setStuck();
  window.addEventListener("scroll", setStuck, { passive: true });

  const revealables = document.querySelectorAll(".reveal");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    },
    { rootMargin: "0px 0px -10%", threshold: 0.12 },
  );

  revealables.forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${Math.min(i % 4, 3) * 70}ms`;
    observer.observe(el);
  });
</script>

<style>
  .skip {
    position: absolute;
    left: 50%;
    top: -3rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--white);
    box-shadow: var(--shadow-md);
    font-weight: 600;
    transform: translateX(-50%);
    transition: top 0.25s var(--ease);
  }

  .skip:focus-visible {
    top: 0;
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      backdrop-filter 0.35s var(--ease);
  }

  .site-header.is-stuck {
    background: rgba(255, 255, 255, 0.78);
    border-bottom-color: var(--fog);
    backdrop-filter: blur(16px) saturate(1.5);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .brand img {
    width: 30px;
    height: 30px;
  }

  .nav {
    display: none;
    gap: 1.6rem;
    font-size: 0.93rem;
    font-weight: 500;
  }

  .nav a {
    position: relative;
    color: var(--slate);
    transition: color 0.25s var(--ease);
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -0.35rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient);
    transition: right 0.35s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav a:hover::after {
    right: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-sm {
    padding: 0.5rem 1.05rem;
    font-size: 0.88rem;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 5vw, 3.5rem));
    padding-bottom: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        58% 50% at 10% 4%,
        rgba(139, 92, 246, 0.2),
        transparent 62%
      ),
      radial-gradient(
        48% 46% at 92% 10%,
        rgba(34, 211, 238, 0.18),
        transparent 60%
      ),
      radial-gradient(
        62% 58% at 74% 96%,
        rgba(59, 130, 246, 0.16),
        transparent 62%
      ),
      var(--snow);
  }

  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 50% 40%, #000, transparent 75%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(2.75rem, 6vw, 4.5rem);
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--fog);
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.8);
    box-shadow: var(--shadow-sm);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--slate);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
  }

  .hero h1 {
    margin: 1.3rem 0 1.1rem;
  }

  .hero-lead {
    max-width: 36rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 1.9rem;
  }

  .hero-actions.center {
    justify-content: center;
    margin-bottom: 0;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
  }

  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .hero-meta li + li::before {
    content: "";
    flex: none;
    width: 4px;
    height: 4px;
    margin-right: -0.9rem;
    border-radius: 50%;
    background: var(--fog);
  }

  .hero-art {
    position: relative;
    margin: 0;
  }

  .hero-art::before {
    content: "";
    position: absolute;
    inset: -14% -10% -20%;
    border-radius: 50%;
    background: var(--gradient-warm);
    filter: blur(64px);
    opacity: 0.3;
  }

  .hero-art img {
    position: relative;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    animation: float 9s var(--ease) infinite;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 3vw, 2.25rem);
    display: none;
    align-items: center;
    gap: 0.5rem;
    transform: translateX(-50%);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .scroll-cue svg {
    animation: nudge 2.4s var(--ease) infinite;
  }

  .scroll-cue:hover {
    color: var(--slate);
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section-head h2 {
    margin-bottom: 0.9rem;
  }

  .cards {
    display: grid;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
  }

  .card {
    padding: 1.65rem;
    border: 1px solid var(--fog);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--violet) 35%, var(--fog));
    box-shadow: var(--shadow-md);
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    margin-bottom: 1.1rem;
    border-radius: 0.85rem;
    color: var(--white);
    background: var(--gradient);
    box-shadow: 0 10px 22px -12px rgba(139, 92, 246, 0.9);
  }

  .card h3 {
    margin-bottom: 0.45rem;
  }

  .card p {
    font-size: 0.95rem;
  }

  .split {
    background: linear-gradient(180deg, var(--white), var(--snow));
  }

  .split-grid {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
    align-items: center;
  }

  .split-link {
    margin-top: 1.4rem;
  }

  .art-card {
    max-width: 21rem;
    margin: 0 auto;
    padding: 1rem;
    border: 1px solid var(--fog);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-md);
  }

  .art-card img {
    width: 100%;
    border-radius: var(--radius);
  }

  .art-card.wide {
    max-width: 26rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips.center {
    justify-content: center;
  }

  .chip {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--fog);
    border-radius: var(--pill);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--slate);
  }

  .stack {
    background: var(--snow);
    border-block: 1px solid var(--fog);
  }

  .stack-inner {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .note {
    position: relative;
    max-width: 48rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 4vw, 2.6rem);
    padding-left: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--fog);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .note::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--gradient);
  }

  .note h2 {
    margin-bottom: 0.9rem;
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
  }

  .note-section {
    padding-top: 0;
  }

  .cta-section {
    padding-top: 0;
  }

  .cta-panel {
    position: relative;
    padding: clamp(2.75rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 3rem);
    border-radius: var(--radius-lg);
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(
        75% 110% at 50% -10%,
        rgba(34, 211, 238, 0.32),
        transparent 58%
      ),
      linear-gradient(135deg, #4c1d95, #1d4ed8);
    box-shadow: var(--shadow-lg);
  }

  .cta-panel h2 {
    color: var(--white);
    margin-bottom: 0.85rem;
  }

  .cta-mark {
    width: 3.5rem;
    height: auto;
    margin: 0 auto 1.35rem;
  }

  .cta-lead {
    max-width: 34rem;
    margin: 0 auto 2rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .cta-panel .btn-secondary {
    color: var(--white);
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.34);
    box-shadow: none;
    backdrop-filter: blur(8px);
  }

  .cta-panel .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .site-footer {
